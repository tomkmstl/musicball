<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!-- Make the root (/) load index.php -->
        <rule name="Root to Index" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="index.php" />
        </rule>

        <!-- Pretty URLs: /questions -> questions.php -->
        <rule name="Questions Pretty URL" stopProcessing="true">
          <match url="^questions/?$" />
          <action type="Rewrite" url="questions.php" />
        </rule>

        <!-- Pretty URLs: /choice -> choice.php -->
        <rule name="Choice Pretty URL" stopProcessing="true">
          <match url="^choice/?$" />
          <action type="Rewrite" url="choice.php" />
        </rule>

        <!-- Pretty URLs: /vote -> vote.php -->
        <rule name="Vote Pretty URL" stopProcessing="true">
          <match url="^vote/?$" />
          <action type="Rewrite" url="vote.php" />
        </rule>


        <!-- Pretty URLs: /season-setup -> season_setup.php -->
        <rule name="Season Setup Pretty URL" stopProcessing="true">
          <match url="^season-setup/?$" />
          <action type="Rewrite" url="season_setup.php" />
        </rule>

        <!-- Pretty URLs: /admin -> admin.php -->
        <rule name="Admin Pretty URL" stopProcessing="true">
          <match url="^admin/?$" />
          <action type="Rewrite" url="admin.php" />
        </rule>

        <!-- Pretty URLs: /season-rounds -> season_rounds.php -->
        <rule name="Season Rounds Pretty URL" stopProcessing="true">
          <match url="^season-rounds/?$" />
          <action type="Rewrite" url="season_rounds.php" />
        </rule>


        <!-- Pretty URLs: /season -> season.php -->
        <rule name="Season Pretty URL" stopProcessing="true">
          <match url="^season/?$" />
          <action type="Rewrite" url="season.php" />
        </rule>

        <!-- Pretty URLs: /song -> song.php -->
        <rule name="Song Pretty URL" stopProcessing="true">
          <match url="^song/?$" />
          <action type="Rewrite" url="song.php" />
        </rule>

        <!-- Pretty URLs: /round-vote -> round_vote.php -->
        <rule name="Round Vote Pretty URL" stopProcessing="true">
          <match url="^round-vote/?$" />
          <action type="Rewrite" url="round_vote.php" />
        </rule>

        <!-- Pretty URLs: /standings -> standings.php -->
        <rule name="Standings Pretty URL" stopProcessing="true">
          <match url="^standings/?$" />
          <action type="Rewrite" url="standings.php" />
        </rule>


        <!-- Pretty URLs: /settings -> settings.php -->
        <rule name="Settings Pretty URL" stopProcessing="true">
          <match url="^settings/?$" />
          <action type="Rewrite" url="settings.php" />
        </rule>
        <!-- Pretty URLs: /results -> results.php -->
        <rule name="Results Pretty URL" stopProcessing="true">
          <match url="^results/?$" />
          <action type="Rewrite" url="results.php" />
        </rule>

        <!-- Pretty URLs: /final -> final.php -->
        <rule name="Final Pretty URL" stopProcessing="true">
          <match url="^final/?$" />
          <action type="Rewrite" url="final.php" />
        </rule>

        <!-- Optional: /index -> index.php (escape hatch) -->
        <rule name="Index Pretty URL" stopProcessing="true">
          <match url="^index/?$" />
          <action type="Rewrite" url="index.php" />
        </rule>

        <!-- Allow all files and directories normally -->
        <rule name="Ignore Existing Files/Folders" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
